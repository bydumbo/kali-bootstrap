# Beispiel-Konfiguration für kali-bootstrap (wird von setup.sh nach config.env kopiert)

# GitHub-Benutzername (wird von setup.sh abgefragt, falls leer)
GITHUB_USER=""

# Name des privaten Sync-Repos auf GitHub
SYNC_REPO="kali-sync"

# Sync-Intervall für den systemd-User-Timer
SYNC_INTERVAL="10min"

# Maximale Dateigröße in MB für hooks/pre-commit
MAX_FILE_MB=50

# SSH-Key-Modus: "plain" (ohne Passphrase, z. B. bei LUKS) oder "keychain" (mit Passphrase)
KEY_MODE=""

# Start-Whitelist für das erste Gerät (Pfade relativ zu $HOME)
WHITELIST=(htb notes scripts .zshrc .tmux.conf)
